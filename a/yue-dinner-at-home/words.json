ngo6.","zh":"我很饿。"},{"en":"你[[肚餓]]未呀？","rom":"nei5 tou5 ngo6 mei6 aa3?","zh":"你饿了吗？"}],"rom":"tou5 ngo6","cloze":{"before":"阿詩：我好","ans":"肚餓","after":"呀，我想食蒸魚。","hint":"肚子饿","szh":"阿诗：我好饿呀，我想吃蒸鱼。"}},{"id":9,"expr":"蒸","zh":"蒸","core":"蒸","forms":["蒸"],"syn":[],"note":"广东菜常用做法：蒸魚、蒸蛋。","m":["蒸"],"ctx":"阿詩：我好肚餓呀，我想食蒸魚。","ex":[{"en":"爸爸[[蒸]]魚。","rom":"baa4 baa1 zing1 jyu2.","zh":"爸爸蒸鱼。"},{"en":"我鍾意食[[蒸]]蛋。","rom":"ngo5 zung1 ji3 sik6 zing1 daan2.","zh":"我喜欢吃蒸蛋。"}],"rom":"zing1","cloze":{"before":"阿詩：我好肚餓呀，我想食","ans":"蒸","after":"魚。","hint":"蒸","szh":"阿诗：我好饿呀，我想吃蒸鱼。"}},{"id":10,"expr":"仲","zh":"还；还（有）","core":"仲","forms":["仲"],"syn":[],"note":"相当于普通话的“还”。仲想食 = 还想吃，仲要 = 还要。","m":["仲"],"ctx":"爸爸：好啊，我蒸魚。仲想食乜？","ex":[{"en":"我[[仲]]想飲湯。","rom":"ngo5 zung6 soeng2 jam2 tong1.","zh":"我还想喝汤。"},{"en":"佢[[仲]]未返嚟。","rom":"keoi5 zung6 mei6 faan1 lai4.","zh":"她还没回来。"}],"rom":"zung6","cloze":{"before":"爸爸：好啊，我蒸魚。","ans":"仲","after":"想食乜？","hint":"还；还（有）","szh":"爸爸：好，我蒸鱼。还想吃什么？"}},{"id":11,"expr":"碗","zh":"碗（量词）","core":"碗","forms":["碗"],"syn":[],"note":"一碗湯、一碗飯。也可以当量词用。","m":["碗"],"ctx":"阿詩：仲要一碗湯，唔該畀多啲飯我。","ex":[{"en":"一[[碗]]湯，唔該。","rom":"jat1 wun2 tong1, m4 goi1.","zh":"一碗汤，谢谢。"},{"en":"畀我一[[碗]]飯。","rom":"bei2 ngo5 jat1 wun2 faan6.","zh":"给我一碗饭。"}],"rom":"wun2","cloze":{"before":"阿詩：仲要一","ans":"碗","after":"湯，唔該畀多啲飯我。","hint":"碗（量词）","szh":"阿诗：还要一碗汤，麻烦多给我一点饭。"}},{"id":12,"expr":"畀","zh":"给","core":"畀","forms":["畀"],"syn":[],"note":"粤语的“给”说 畀（bei2）。注意语序：畀 + 东西 + 人：畀本書我（给我一本书）。","m":["畀"],"ctx":"阿詩：仲要一碗湯，唔該畀多啲飯我。","ex":[{"en":"[[畀]]杯水我。","rom":"bei2 bui1 seoi2 ngo5.","zh":"给我一杯水。"},{"en":"爸爸[[畀]]錢我。","rom":"baa4 baa1 bei2 cin2 ngo5.","zh":"爸爸给我钱。"}],"rom":"bei2","cloze":{"before":"阿詩：仲要一碗湯，唔該","ans":"畀","after":"多啲飯我。","hint":"给","szh":"阿诗：还要一碗汤，麻烦多给我一点饭。"}},{"id":14,"expr":"得啦","zh":"行了；好了","core":"得啦","forms":["得啦","得"],"syn":[],"note":"答应了别人的要求。得 = 行、可以，啦 = 语气词。","m":["得啦"],"ctx":"爸爸：得啦，快啲去洗手，即刻食飯。","ex":[{"en":"[[得啦]]，我去洗手。","rom":"dak1 laa1, ngo5 heoi3 sai2 sau2.","zh":"行了，我去洗手。"},{"
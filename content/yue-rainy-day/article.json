   {
    "kind": "sub",
    "en": "阿詩準備出街，爸爸叫住佢。",
    "rom": "aa3 si1 zeon2 bei6 ceot1 gaai1, baa4 baa1 giu3 zyu6 keoi5.",
    "zh": "阿诗准备出门，爸爸叫住了她。",
    "notes": [
     "準備：准备。出街：出门、上街。",
     "叫住：叫住（让人停下）。"
    ]
   },
   {
    "kind": "body",
    "en": "爸爸：阿詩，你去邊度呀？",
    "rom": "baa4 baa1: aa3 si1, nei5 heoi3 bin1 dou6 aa3?",
    "zh": "爸爸：阿诗，你去哪里呀？",
    "notes": [
     "去邊度：去哪里，第 3 课学过。"
    ],
    "p": 1
   },
   {
    "kind": "body",
    "en": "阿詩：我去搵朋友。",
    "rom": "aa3 si1: ngo5 heoi3 wan2 pang4 jau5.",
    "zh": "阿诗：我去找朋友。",
    "notes": [
     "搵：找。搵朋友：找朋友（见朋友）。"
    ],
    "p": 2
   },
   {
    "kind": "body",
    "en": "爸爸：天文台話今日會落雨，記得帶遮。",
    "rom": "baa4 baa1: tin1 man4 toi4 waa6 gam1 jat6 wui5 lok6 jyu5, gei3 dak1 daai3 ze1.",
    "zh": "爸爸：天文台说今天会下雨，记得带伞。",
    "notes": [
     "天文台：香港天文台，发布天气预报。",
     "話：说。會：会（将来）。"
    ],
    "p": 3
   },
   {
    "kind": "body",
    "en": "阿詩：唔係嘛？而家好好天喎。",
    "rom": "aa3 si1: m4 hai6 maa3? ji4 gaa1 hou2 hou2 tin1 wo3.",
    "zh": "阿诗：不会吧？现在天气很好啊。",
    "notes": [
     "唔係嘛：不会吧？真的吗？表示惊讶、怀疑。",
     "而家：现在。好天：天气好、晴天。喎：提醒语气（第 5 课）。"
    ],
    "p": 4
   },
   {
    "kind": "body",
    "en": "爸爸：下晝會變天㗎，仲會凍啲。",
    "rom": "baa4 baa1: haa6 zau3 wui5 bin3 tin1 gaa3, zung6 wui5 dung3 di1.",
    "zh": "爸爸：下午会变天的，还会冷一点。",
    "notes": [
     "下晝：下午。變天：天气变坏。",
     "㗎：句尾语气词，表示“是这样的”，带解释、肯定的语气。",
     "仲：还（第 6 课）。凍啲：冷一点。"
    ],
    "p": 5
   },
   {
    "kind": "body",
    "en": "阿詩：好啦，我帶埋件褸。",
    "rom": "aa3 si1: hou2 laa1, ngo5 daai3 maai4 gin6 lau1.",
    "zh": "阿诗：好吧，我把外套也带上。",
    "notes": [
     "帶埋：也带上。埋 放在动词后面表示“连……也、一并”。",
     "件褸：一件外套。件 是第 5 课学的量词。"
    ],
    "p": 6
   }

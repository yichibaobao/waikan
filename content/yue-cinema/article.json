  "sents": [
   {
    "kind": "title",
    "en": "兩張戲飛，唔該！",
    "rom": "loeng5 zoeng1 hei3 fei1, m4 goi1!",
    "zh": "两张电影票，谢谢！",
    "notes": [
     "戲飛：电影票。飛 是粤语的“票”（来自英语 fare）。"
    ]
   },
   {
    "kind": "sub",
    "en": "阿詩同朋友去戲院睇戲。",
    "rom": "aa3 si1 tung4 pang4 jau5 heoi3 hei3 jyun2 tai2 hei3.",
    "zh": "阿诗和朋友去电影院看电影。",
    "notes": [
     "戲院：电影院。睇戲：看电影。粤语“电影”常说 戲。"
    ]
   },
   {
    "kind": "body",
    "en": "職員：你好，想睇邊套戲呀？",
    "rom": "zik1 jyun4: nei5 hou2, soeng2 tai2 bin1 tou3 hei3 aa3?",
    "zh": "职员：你好，想看哪部电影？",
    "notes": [
     "邊套：哪一部。邊 = 哪，套 = 部（电影的量词）。"
    ],
    "p": 1
   },
   {
    "kind": "body",
    "en": "阿詩：七點嗰場，兩張飛，唔該。",
    "rom": "aa3 si1: cat1 dim2 go2 coeng4, loeng5 zoeng1 fei1, m4 goi1.",
    "zh": "阿诗：七点那场，两张票，谢谢。",
    "notes": [
     "嗰場：那一场。嗰 = 那，場 = 场（放映场次）。",
     "兩張飛：两张票。張 是票、纸的量词。"
    ],
    "p": 2
   },
   {
    "kind": "body",
    "en": "職員：想坐前面定後面？",
    "rom": "zik1 jyun4: soeng2 co5 cin4 min6 ding6 hau6 min6?",
    "zh": "职员：想坐前面还是后面？",
    "notes": [
     "坐：坐。前面（第 3 课）、定（第 2 课）。後面：后面。"
    ],
    "p": 3
   },
   {
    "kind": "body",
    "en": "阿詩：後面啦，要兩個連埋嘅位。",
    "rom": "aa3 si1: hau6 min6 laa1, jiu3 loeng5 go3 lin4 maai4 ge3 wai2.",
    "zh": "阿诗：后面吧，要两个连在一起的座位。",
    "notes": [
     "連埋：连在一起。位：座位，读 wai2。"
    ],
    "p": 4
   },
   {
    "kind": "body",
    "en": "職員：一共一百六十蚊。",
    "rom": "zik1 jyun4: jat1 gung6 jat1 baak3 luk6 sap6 man1.",
    "zh": "职员：一共一百六十块。",
    "notes": [
     "一共：一共。一百六十：一百六十。蚊 是第 2 课学的“块”。"
    ],
    "p": 5
   },
   {
    "kind": "body",
    "en": "阿詩：可唔可以用八達通？",
    "rom": "aa3 si1: ho2 m4 ho2 ji5 jung6 baat3 daat6 tung1?",
    "zh": "阿诗：可以用八达通吗？",
    "notes": [
     "可唔可以：可不可以，A 唔 A 句型（第 3 课）。",
     "八達通：香港的交通卡，买东西也能用。"
    ],
    "p": 6
   },
   {
    "kind": "body",
    "en": "職員：得，喺度拍卡就得。",
    "rom": "zik1 jyun4: dak1, hai2 dou6 paak3 kaat1 zau6 dak1.",
    "zh": "职员：可以，在这里拍卡就行。",
    "notes": [
     "得：可以、行。喺度：在这里。拍卡：刷卡（把卡放上去“拍”一下）。"
    ],
    "p": 7
   }

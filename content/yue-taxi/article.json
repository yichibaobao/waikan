  "sents": [
   {
    "kind": "title",
    "en": "搭的士去中環",
    "rom": "daap3 dik1 si2 heoi3 zung1 waan4",
    "zh": "坐出租车去中环",
    "notes": [
     "搭：坐（交通工具）。搭的士 = 坐出租车。",
     "的士：出租车，来自英文 taxi。",
     "中環：中环，香港岛的商业区。"
    ]
   },
   {
    "kind": "sub",
    "en": "阿詩趕時間，喺街口叫咗架的士。",
    "rom": "aa3 si1 gon2 si4 gaan3, hai2 gaai1 hau2 giu3 zo2 gaa3 dik1 si2.",
    "zh": "阿诗赶时间，在路口叫了一辆出租车。",
    "notes": [
     "趕時間：赶时间。",
     "喺街口：在路口。喺 = 在（第 3 课学过）。",
     "架：辆，车的量词。叫咗架的士 = 叫了一辆出租车（“一”常省略）。"
    ]
   },
   {
    "kind": "body",
    "en": "阿詩：司機，唔該去中環碼頭。",
    "rom": "aa3 si1: si1 gei1, m4 goi1 heoi3 zung1 waan4 maa5 tau4.",
    "zh": "阿诗：司机，麻烦去中环码头。",
    "notes": [
     "司機：司机，上车直接这样称呼就行。",
     "唔該：麻烦你（第 2 课学过）。",
     "碼頭：码头，读 maa5 tau4。"
    ],
    "p": 1
   },
   {
    "kind": "body",
    "en": "司機：好。你趕唔趕時間呀？",
    "rom": "si1 gei1: hou2. nei5 gon2 m4 gon2 si4 gaan3 aa3?",
    "zh": "司机：好。你赶不赶时间？",
    "notes": [
     "趕唔趕：赶不赶。A 唔 A 问句（第 3 课 遠唔遠 学过）。",
     "好：好的，表示答应。"
    ],
    "p": 2
   },
   {
    "kind": "body",
    "en": "阿詩：好趕呀！大概要幾耐？",
    "rom": "aa3 si1: hou2 gon2 aa3! daai6 koi3 jiu3 gei2 noi6?",
    "zh": "阿诗：很赶啊！大概要多久？",
    "notes": [
     "好趕：很赶。好 + 形容词 = 很……。",
     "大概：大概。",
     "幾耐：多久。要幾耐 = 要多长时间。"
    ],
    "p": 3
   },
   {
    "kind": "body",
    "en": "司機：而家塞車，可能要半個鐘。",
    "rom": "si1 gei1: ji4 gaa1 sak1 ce1, ho2 nang4 jiu3 bun3 go3 zung1.",
    "zh": "司机：现在堵车，可能要半个小时。",
    "notes": [
     "而家：现在（第 8 课学过）。",
     "塞車：堵车。",
     "半個鐘：半个小时。粤语“小时”常说 鐘（頭），一個鐘 = 一个小时。"
    ],
    "p": 4
   },
   {
    "kind": "body",
    "en": "阿詩：嘩，咁點算好？我三點要搭船。",
    "rom": "aa3 si1: waa3, gam2 dim2 syun3 hou2? ngo5 saam1 dim2 jiu3 daap3 syun4.",
    "zh": "阿诗：哇，那怎么办？我三点要坐船。",
    "notes": [
     "嘩：哇（第 9 课学过），这里表示着急。",
     "咁：那么（第 5 课学过）。點算好：怎么办才好。",
     "搭船：坐船。注意 三點（三点）的 點 读 dim2，和 點算 的 點 一样。"
    ],
    "p": 5
   },
   {
    "kind": "body",
    "en": "司機：唔使驚，我行第二條路，十五分鐘就到。",
    "rom": "si1 gei1: m4 sai2 geng1, ngo5 haang4 dai6 ji6 tiu4 lou6, sap6 ng5 fan1 zung1 zau6 dou3.",
    "zh": "司机：不用怕，我走另一条路，十五分钟就到。",
    "notes": [
     "唔使驚：不用怕（见语法点）。驚 = 怕。",
     "第二條路：另一条路。第二 在这里是“别的”，不一定是“第二”。",
     "行……路：走……路。分鐘、就、到 都学过（第 3 课）。"
    ],
    "p": 6
   }
  ],
